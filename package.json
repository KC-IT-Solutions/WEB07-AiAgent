{
  "name": "web07-aiagent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server/server.js",
    "test": "npm run test:compile && node --test --test-concurrency=2 .test-dist/tests/unit/*.test.js .test-dist/tests/integration/*.test.js .test-dist/tests/frontend/*.test.js .test-dist/tests/system/*.test.js .test-dist/src/client/components/chat/__tests__/ChatView.test.js .test-dist/src/client/components/settings/__tests__/SettingsView.test.js",
    "test:compile": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('.test-dist', { recursive: true, force: true })\" && tsc -p tsconfig.test.json",
    "test:unit": "npm run test:compile && node --test --test-concurrency=2 .test-dist/tests/unit/*.test.js",
    "test:integration": "npm run test:compile && node --test --test-concurrency=2 .test-dist/tests/integration/*.test.js",
    "test:frontend": "npm run test:compile && node --test --test-concurrency=2 .test-dist/tests/frontend/*.test.js",
    "test:system": "npm run test:compile && node --test --test-concurrency=2 .test-dist/tests/system/*.test.js",
    "test:e2e": "npm run build && npm run build:client && npm run test:compile && playwright test",
    "test:all": "npm test && npm run test:e2e",
    "test:live": "npm run test:compile && node --test --test-concurrency=2 .test-dist/tests/live/*.test.js",
    "build:client": "tsc -p tsconfig.client.json && node scripts/copy-client-assets.mjs",
    "typecheck:client": "tsc -p tsconfig.client.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.2.0",
    "csv-parser": "^3.2.1",
    "csv-writer": "^1.6.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "express-session": "^1.19.0",
    "express-useragent": "^2.2.2",
    "helmet": "^8.3.0",
    "marked": "^18.0.10",
    "ml-matrix": "^6.15.0",
    "node-schedule": "^2.1.1",
    "nodemailer": "^9.0.5",
    "openai": "^7.5.0",
    "sanitize-html": "^2.17.7",
    "simple-statistics": "^7.10.2",
    "undici": "^7.29.0",
    "youtube-search-api": "^2.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
